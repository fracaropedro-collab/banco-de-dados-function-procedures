CREATE TABLE alunos (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    idade INT NOT NULL
);

INSERT INTO alunos (nome, idade) VALUES
    ('Alice', 18),
    ('Gabriella', 16),
    ('Adriano', 23),
    ('Luis', 28);

DELIMITER //

DROP PROCEDURE IF EXISTS buscar_alunos_por_idade//

CREATE PROCEDURE buscar_alunos_por_idade(IN p_idade_minima INT)
BEGIN
    SELECT *
    FROM alunos
    WHERE idade >= p_idade_minima;
END//

DELIMITER ;

CALL buscar_alunos_por_idade(18);
